# Python
__pycache__/
*.py[cod]
.venv/

# Runtime spool data (jobs people printed stay on their own machine)
spool/incoming/*
spool/printed/*
spool/index.jsonl
!spool/incoming/.gitkeep
!spool/printed/.gitkeep
*.tmp

# Machine-specific notes and logs
notes/environment.txt
notes/first-test.txt
notes/*.log
notes/*.pid
notes/*.sh
notes/*.py
notes/cyd-backup/
*.bin

# Firmware secrets & build output
firmware/CYD_LE_SPOOLER_Arduino/spooler_config.h
firmware/**/build/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
