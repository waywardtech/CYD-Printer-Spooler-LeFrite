# systemd *user* unit for LE SPOOLER.
# Installed by `./install.sh --service`, which fills in @ROOT@ and @PORT@.
# Manual install:
#   mkdir -p ~/.config/systemd/user
#   sed "s#@ROOT@#$PWD#g; s#@PORT@#8765#g" contrib/le-spooler.service > ~/.config/systemd/user/le-spooler.service
#   systemctl --user daemon-reload && systemctl --user enable --now le-spooler
[Unit]
Description=LE SPOOLER fanfold printer spooler
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@/server
ExecStart=/usr/bin/env python3 @ROOT@/server/le_spooler_server.py --port @PORT@ --quiet
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
